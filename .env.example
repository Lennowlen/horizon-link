# Konfigurasi Server Nextendo Mandiri

# 1. IP Publik Server (Penting untuk NAT Check Nintendo Pia)
# SERVER_IP: IP publik utama (Account server, SNI router, game server, nncs1)
SERVER_IP=103.x.x.1
# NAT_IP: IP publik kedua (Wajib berbeda agar NAT Traversal 2618-201 lolos)
NAT_IP=103.x.x.2

# 2. Domain & URL Portal
NEXTENDO_BASE_URL=https://switch.lan
NEXTENDO_PUBLIC_HOST=switch.lan

# 3. Secret Keys (Generate dengan openssl rand -hex 32)
NEXTENDO_SECRET=ganti_dengan_random_hex_32_karakter
NEXTENDO_INTERNAL_KEY=ganti_dengan_random_hex_32_karakter
NEXTENDO_SECURE_PASSWORD=ganti_dengan_random_hex_32_karakter
NEXTENDO_ADMIN_EMAILS=admin@switch.lan

# 4. Port Binding Game Server
MK8_UDP_PORT=60003
SSBU_UDP_PORT=60005
SPLATOON2_UDP_PORT=60004
NNCS_PROBE_PORT_1=10025
NNCS_PROBE_PORT_2=10125
